#!/bin/bash

# Define the CPU usage threshold (in percentage) for identifying resource-intensive processes.
CPU_THRESHOLD=20

# Use 'top' to monitor CPU usage, filter for processes exceeding the threshold, and display their PID, user, and CPU usage.
# The '-b' flag runs top in batch mode, '-n 1' runs it once, and the output is piped to 'awk' for filtering.
# 'awk' then prints the second field (PID), eleventh field (user), and twelfth field (CPU usage).
top -b -n 1 | awk '/[cC]PU/ {print $2, $11, $12}' | awk -v threshold="$CPU_THRESHOLD" '$10 > threshold {print $0}'

# Prompt the user to choose an action: 'k' for killing the process or 'r' for reducing its priority.
read -p "Choose an action [k/r]: " action

# If the user chooses 'k', kill the process.
if [ "$action" = "k" ]; then
  read -p "Enter PID to kill: " pid
  kill -9 $pid
  echo "Process with PID $pid has been terminated."

# If the user chooses 'r', reduce the priority of the process.
elif [ "$action" = "r" ]; then
  read -p "Enter PID to reduce priority: " pid
  renice 10 -p $pid
  echo "Priority of process with PID $pid has been reduced."

# If an invalid action is selected, inform the user.
else
  echo "Invalid action selected."
fi