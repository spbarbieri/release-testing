#!/bin/bash
# Define the threshold for excessive GC times in milliseconds
GC_THRESHOLD=1000

# Function to check GC times and send alert if threshold is exceeded
check_gc_times() {
  # Use jstat to get the GC times
  # -t 1 indicates to print the times for the last minute
  # -f GC indicates to print the 'GC' related statistics
  # -o u,g,m,p,emp,a,def,max indicate the specific statistics to print
  jstat -t 1 -f GC -o u,g,m,p,emp,a,def,max  <java_process_pid> | while read -r line
  do
    # Extract the 'Emp' (elapsed time) value
    elapsed=$(echo $line | awk '{print $6}')

    # Check if the elapsed time exceeds the threshold
    if (( $(echo "$elapsed > $GC_THRESHOLD" | bc -l) )); then
      echo "Alert: Excessive GC times detected. Elapsed time: $elapsed ms"
      # Send an alert (replace with your alerting mechanism)
      # Example: send_alert.sh $elapsed
      # send_alert.sh $elapsed
    fi
  done
}

# Replace <java_process_pid> with the actual PID of your Java process
check_gc_times <java_process_pid>