#!/bin/bash
# This script checks for processes consuming high CPU
# ps aux command is used to list all processes
# We filter out the lines containing 'CPU' to focus on CPU usage
# We then use awk to calculate the percentage of CPU used by each process
# If a process uses more than 5% CPU, it is considered high
# The output is then piped to grep to filter out high CPU processes
# The top 5 high CPU processes are printed
ps aux | grep CPU | awk '{cpu_percent=$5/100.0*$6} $1!="cpu" && $2!="cpu" && $CPU_percent > 5 {print $1,$2,$3,$4,$5}' | sort -k 5 -nr | head -5