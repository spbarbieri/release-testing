#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Script: k8s_node_diagnose.sh
# Purpose: Diagnose common issues on a Kubernetes worker node.
# Steps:
#   1. Scan kubelet logs for errors or warnings.
#   2. Verify node appears healthy via `kubectl get nodes`.
#   3. If node is absent, confirm the node has a valid IP address.
#   4. If node is present but not Ready, attempt to restart kubelet.
# ------------------------------------------------------------

# ---------- Configuration ----------
KUBELET_UNIT="kubelet"
MAX_LOG_LINES=200          # Number of recent log lines to inspect
NODE_NAME="$(hostname)"
IP_INTERFACE_EXCLUDE=("lo")
REQUIRED_PRIVILEGES=("kubectl" "systemctl" "journalctl")

# ---------- Helper Functions ----------
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${1:-INFO}] ${2}"
}

require_commands() {
    local missing=()
    for cmd in "${REQUIRED_PRIVILEGES[@]}"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done
    if (( ${#missing[@]} )); then
        log "ERROR" "Missing required commands: ${missing[*]}"
        exit 2
    fi
}

has_errors_in_logs() {
    # Search recent kubelet logs for warnings or errors (case‑insensitive)
    if journalctl -u "$KUBELET_UNIT" -p warning -n "$MAX_LOG_LINES" --no-pager | grep -iq .; then
        return 0
    fi
    return 1
}

display_log_issues() {
    log "WARN" "Found warnings/errors in kubelet logs:"
    journalctl -u "$KUBELET_UNIT" -p warning -n "$MAX_LOG_LINES" --no-pager
}

node_ready_status() {
    # Returns one of: Ready, NotReady, Unknown, "" (not found)
    kubectl get node "$NODE_NAME" -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}' 2>/dev/null || echo ""
}

node_exists() {
    kubectl get node "$NODE_NAME" >/dev/null 2>&1
}

list_non_loopback_ips() {
    ip -o -4 addr list | awk '!/^[0-9]+: lo / {print $4}'
}

has_valid_ip() {
    local ips
    mapfile -t ips < <(list_non_loopback_ips)
    (( ${#ips[@]} )) && return 0
    return 1
}

restart_kubelet() {
    if [[ "$(id -u)" -ne 0 ]]; then
        log "ERROR" "Root privileges required to restart kubelet."
        exit 3
    fi
    log "INFO" "Restarting kubelet service..."
    systemctl restart "$KUBELET_UNIT"
    sleep 5
    # Re‑check readiness after restart
    local new_status
    new_status="$(node_ready_status)"
    if [[ "$new_status" == "True" ]]; then
        log "INFO" "Node is now Ready."
    else
        log "WARN" "Node remains not Ready after kubelet restart (status=$new_status)."
    fi
}

# ---------- Main Execution ----------
require_commands

log "INFO" "Starting diagnostics for node '$NODE_NAME'."

# Step 1 – Inspect kubelet logs
if has_errors_in_logs; then
    display_log_issues
    log "ERROR" "Log inspection revealed issues; aborting further automated checks."
    exit 1
else
    log "INFO" "No warnings or errors detected in recent kubelet logs."
fi

# Step 2 – Verify node presence/status via kubectl
if node_exists; then
    local ready_status
    ready_status="$(node_ready_status)"
    case "$ready_status" in
        True)
            log "INFO" "Node reports Ready status. No further action needed."
            exit 0
            ;;
        "")
            log "WARN" "Unable to determine Ready condition; treating as unknown."
            ;;
        *)
            log "WARN" "Node is present but not Ready (status=${ready_status})."
            ;;
    esac
else
    log "WARN" "Node '$NODE_NAME' does not appear in 'kubectl get nodes' output."
fi

# Step 3 – Confirm network configuration (IP address)
if has_valid_ip; then
    log "INFO" "Node has at least one non‑loopback IPv4 address."
else
    log "ERROR" "No non‑loopback IP address found on the node. Check network interfaces."
    ip addr show
    exit 4
fi

# Step 4 – Attempt recovery by restarting kubelet
restart_kubelet

log "INFO" "Diagnostics completed."

exit 0