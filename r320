#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Configuration – adjust these variables as needed
# ------------------------------------------------------------
LOG_JOURNAL_UNIT="kubelet"          # systemd unit to inspect for errors
LOG_SINCE="1h"                      # time window for log inspection (e.g., "30m", "2h")
ERROR_PATTERNS=("error" "warn")    # case‑insensitive patterns to search for
KUBECTL_CMD="${KUBECTL_CMD:-kubectl}"   # allow overriding kubectl location
NODE_NAME="$(hostname)"            # assumes the node's hostname matches its k8s name
IP_INTERFACE=""                     # optional: specify interface (e.g., eth0); leave empty for any

# ------------------------------------------------------------
# Helper functions
# ------------------------------------------------------------
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${1^^}] $2"
}

run_or_exit() {
    local cmd=("$@")
    "${cmd[@]}" || { log "error" "Command failed: ${cmd[*]}"; exit 1; }
}

# ------------------------------------------------------------
# Step 1 – Scan kubelet logs for errors or warnings
# ------------------------------------------------------------
check_logs() {
    log "info" "Scanning ${LOG_JOURNAL_UNIT} logs for the last ${LOG_SINCE}..."
    # Pull logs from journald; fallback to /var/log if journald unavailable
    if journalctl -u "${LOG_JOURNAL_UNIT}" -n 0 &>/dev/null; then
        LOG_OUTPUT=$(journalctl -u "${LOG_JOURNAL_UNIT}" --since "${LOG_SINCE}" -p info)
    else
        LOG_FILE="/var/log/${LOG_JOURNAL_UNIT}.log"
        if [[ -f "${LOG_FILE}" ]]; then
            LOG_OUTPUT=$(tail -n +1 "${LOG_FILE}")
        else
            log "warning" "No journal nor log file found for ${LOG_JOURNAL_UNIT}; skipping log check."
            return 0
        fi
    fi

    # Look for any pattern defined in ERROR_PATTERNS (case‑insensitive)
    for pat in "${ERROR_PATTERNS[@]}"; do
        if grep -i "${pat}" <<<"${LOG_OUTPUT}" >/dev/null; then
            log "error" "Found '${pat}' entries in ${LOG_JOURNAL_UNIT} logs:"
            grep -i "${pat}" <<<"${LOG_OUTPUT}"
            return 1
        fi
    done

    log "info" "No error or warning patterns detected in recent logs."
    return 0
}

# ------------------------------------------------------------
# Step 3 – Verify node appears healthy via kubectl
# ------------------------------------------------------------
check_node_status() {
    log "info" "Fetching node status from the control plane..."
    NODE_JSON=$(${KUBECTL_CMD} get node "${NODE_NAME}" -o json 2>/dev/null) || {
        log "error" "Node '${NODE_NAME}' not found in cluster."
        return 1
    }

    PHASE=$(jq -r '.status.conditions[] | select(.type=="Ready") | .status' <<<"${NODE_JSON}")
    if [[ "${PHASE}" == "True" ]]; then
        log "info" "Node '${NODE_NAME}' reports Ready=True."
        return 0
    else
        log "warning" "Node '${NODE_NAME}' is NOT Ready (status=${PHASE})."
        return 1
    fi
}

# ------------------------------------------------------------
# Step 5 – Validate network configuration (IP address presence)
# ------------------------------------------------------------
check_network() {
    log "info" "Inspecting network interfaces for an assigned IP address..."
    if [[ -n "${IP_INTERFACE}" ]]; then
        IP_INFO=$(ip -4 addr show dev "${IP_INTERFACE}" 2>/dev/null || true)
    else
        IP_INFO=$(ip -4 addr show scope global)
    fi

    if grep -qE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' <<<"${IP_INFO}"; then
        log "info" "At least one IPv4 address is configured on the node."
        return 0
    else
        log "error" "No IPv4 address found on the node."
        return 1
    fi
}

# ------------------------------------------------------------
# Step 7 – Restart kubelet service
# ------------------------------------------------------------
restart_kubelet() {
    log "info" "Attempting to restart the kubelet service..."
    run_or_exit systemctl restart kubelet
    log "info" "kubelet restarted successfully."

    # Give the service a moment to re‑register
    sleep 10
    # Re‑check node readiness once more
    if check_node_status; then
        log "info" "Node recovered and is now Ready."
    else
        log "error" "Node still not Ready after kubelet restart."
        exit 1
    fi
}

# ------------------------------------------------------------
# Main execution flow
# ------------------------------------------------------------
main() {
    # 1️⃣ Log inspection
    if ! check_logs; then
        log "error" "Aborting further checks due to log findings."
        exit 1
    fi

    # 3️⃣ Node status via kubectl
    if check_node_status; then
        log "info" "All checks passed – node is healthy."
        exit 0
    fi

    # 5️⃣ Network verification
    if ! check_network; then
        log "error" "Network issue detected – resolve IP assignment before proceeding."
        exit 1
    fi

    # 7️⃣ Restart kubelet as a remediation step
    restart_kubelet
}

main "$@"