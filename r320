#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Host Availability Diagnostic Script
#
# This script runs a comprehensive set of checks to diagnose
# a “245‑HostAvailabilityRule‑All Entities” alert.
#
# Usage:
#   ./host_diagnostic.sh -h <host_ip_or_fqdn> \
#                        [-e <monitored_endpoint>] \
#                        [-s <service1,service2,...>] \
#                        [-a <monitoring_agent_service>] \
#                        [-t <api_token>]
#
# Example:
#   ./host_diagnostic.sh -h 10.0.1.23 -e api.myapp.internal \
#                        -s sshd,httpd,mysqld -a datadog-agent \
#                        -t abcdef1234567890
# ------------------------------------------------------------

# ---------- Default values ----------
MONITORED_ENDPOINT=""
SERVICE_LIST=()
AGENT_SERVICE="datadog-agent"
API_TOKEN=""

# ---------- Helper Functions ----------
print_usage() {
    echo "Usage: $0 -h <host_ip_or_fqdn> [-e <monitored_endpoint>] [-s <svc1,svc2,...>] [-a <agent_service>] [-t <api_token>]"
    exit 1
}

# Parse comma‑separated list into array
parse_list() {
    IFS=',' read -ra arr <<< "$1"
    echo "${arr[@]}"
}

# Run a command, capture output and errors, write to log file
run_cmd() {
    local description="$1"
    shift
    local cmd=("$@")
    echo "=== ${description} ===" >>"$REPORT_FILE"
    printf "%s\n" "Command: ${cmd[*]}" >>"$REPORT_FILE"
    if ! "${cmd[@]}" >>"$REPORT_FILE" 2>&1; then
        echo "[WARN] Command failed: ${cmd[*]}" >>"$REPORT_FILE"
    fi
    echo "" >>"$REPORT_FILE"
}

# Ensure we have sufficient permissions for privileged commands
ensure_root() {
    if [[ "$(id -u)" -ne 0 ]]; then
        SUDO_CMD="sudo"
    else
        SUDO_CMD=""
    fi
}

# ---------- Argument Parsing ----------
while getopts ":h:e:s:a:t:" opt; do
    case $opt in
        h) TARGET_HOST="${OPTARG}" ;;
        e) MONITORED_ENDPOINT="${OPTARG}" ;;
        s) SERVICE_LIST=($(parse_list "${OPTARG}")) ;;
        a) AGENT_SERVICE="${OPTARG}" ;;
        t) API_TOKEN="${OPTARG}" ;;
        *) print_usage ;;
    esac
done

[[ -z "${TARGET_HOST:-}" ]] && { echo "Error: target host is required."; print_usage; }

# ---------- Setup ----------
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
REPORT_DIR="/tmp/host_diag_${TARGET_HOST}_${TIMESTAMP}"
mkdir -p "$REPORT_DIR"
REPORT_FILE="${REPORT_DIR}/diagnostic_report.txt"

echo "Host Diagnostic Report for ${TARGET_HOST}" >"$REPORT_FILE"
echo "Generated at $(date)" >>"$REPORT_FILE"
echo "Report Directory: $REPORT_DIR" >>"$REPORT_FILE"
echo "" >>"$REPORT_FILE"

ensure_root

# ---------- Section 1: Basic Reachability ----------
run_cmd "Ping test (5 packets)" ping -c 5 "$TARGET_HOST"
run_cmd "Traceroute" traceroute "$TARGET_HOST"
run_cmd "NSLookup (hostname)" nslookup "$TARGET_HOST"

# ---------- Section 2: Network Interfaces & Routing ----------
run_cmd "IP address summary" ip addr show
run_cmd "Routing table" ip route show
if command -v netstat >/dev/null 2>&1; then
    run_cmd "Netstat interface statistics" netstat -i
else
    echo "netstat not found, skipping." >>"$REPORT_FILE"
fi

# ---------- Section 3: Firewall / SELinux ----------
if command -v iptables >/dev/null 2>&1; then
    run_cmd "iptables rules" $SUDO_CMD iptables -L -n -v
else
    echo "iptables not installed, skipping." >>"$REPORT_FILE"
fi

if command -v firewall-cmd >/dev/null 2>&1; then
    run_cmd "firewalld state" $SUDO_CMD firewall-cmd --state || true
fi

if command -v getenforce >/dev/null 2>&1; then
    run_cmd "SELinux mode" getenforce
fi

# ---------- Section 4: Critical Services ----------
if [ "${#SERVICE_LIST[@]}" -gt 0 ]; then
    for svc in "${SERVICE_LIST[@]}"; do
        run_cmd "Systemd status for service '${svc}'" systemctl status "$svc"
    done
else
    echo "No explicit service list provided; showing all failed units." >>"$REPORT_FILE"
    run_cmd "Failed systemd services" systemctl list-units --type=service --state=failed
fi

# ---------- Section 5: Monitoring Agent ----------
run_cmd "Monitoring agent (${AGENT_SERVICE}) status" systemctl status "$AGENT_SERVICE"
run_cmd "Recent error logs for agent" journalctl -u "$AGENT_SERVICE" -p err -n 50
if command -v "${AGENT_SERVICE%%-*}" >/dev/null 2>&1; then
    # Attempt to call a generic "<agent> status" command
    AGENT_CLI="${AGENT_SERVICE%%-*}"
    run_cmd "Agent CLI status" "$AGENT_CLI" status
fi

# ---------- Section 6: Recent System Logs ----------
run_cmd "Journal warnings (last 200 entries)" journalctl -b -p warning -n 200
if [ -f /var/log/syslog ]; then
    run_cmd "Syslog errors (tail 100)" bash -c "grep -i error /var/log/syslog | tail -100"
fi
if [ -f /var/log/messages ]; then
    run_cmd "Messages failures (tail 100)" bash -c "grep -i fail /var/log/messages | tail -100"
fi

# ---------- Section 7: Resource Pressure ----------
run_cmd "Top snapshot (first 20 lines)" top -b -n 1 | head -20
run_cmd "Memory usage" free -m
run_cmd "VMStat (5 samples, 5 sec interval)" vmstat 5 5
if command -v iostat >/dev/null 2>&1; then
    run_cmd "IOStat (extended, 3 samples, 5 sec interval)" iostat -xz 5 3
else
    echo "iostat not installed, skipping." >>"$REPORT_FILE"
fi
run_cmd "Disk usage" df -h

# ---------- Section 8: Open Sockets & Listening Ports ----------
run_cmd "Listening sockets (ss)" ss -tulnp
if command -v lsof >/dev/null 2>&1; then
    run_cmd "Listening TCP ports (lsof)" lsof -iTCP -sTCP:LISTEN -P
else
    echo "lsof not installed, skipping." >>"$REPORT_FILE"
fi

# ---------- Section 9: Application‑Specific Checks ----------
APP_LOG="/opt/app/logs/app.log"
if [ -f "$APP_LOG" ]; then
    run_cmd "App log fatal entries (tail 100)" bash -c "grep -i fatal \"$APP_LOG\" | tail -100"
else
    echo "Application log $APP_LOG not found, skipping." >>"$REPORT_FILE"
fi

if command -v jps >/dev/null 2>&1; then
    run_cmd "Java processes (jps)" jps
    # Capture stack traces for any java process that appears
    JAVA_PIDS=$(jps -q)
    for pid in $JAVA_PIDS; do
        STACKFILE="${REPORT_DIR}/jstack_${pid}.txt"
        if command -v jstack >/dev/null 2>&1; then
            jstack "$pid" >"$STACKFILE" 2>/dev/null || true
            echo "Saved jstack for PID $pid to $STACKFILE" >>"$REPORT_FILE"
        fi
    done
else
    echo "jps not available, skipping Java checks." >>"$REPORT_FILE"
fi

# ---------- Section 10: DNS Resolution for Monitored Endpoints ----------
if [ -n "$MONITORED_ENDPOINT" ]; then
    if command -v dig >/dev/null 2>&1; then
        run_cmd "dig short for endpoint" dig +short "$MONITORED_ENDPOINT"
    fi
    if command -v host >/dev/null 2>&1; then
        run_cmd "host lookup for endpoint" host "$MONITORED_ENDPOINT"
    fi
fi

# ---------- Section 11: External Monitoring Data ----------
if [ -n "$API_TOKEN" ]; then
    METRICS_URL="https://monitoring.example.com/api/v1/metrics?host=${TARGET_HOST}&range=5m"
    run_cmd "Pull recent metrics via API" curl -s -X GET "$METRICS_URL" -H "Authorization: Bearer $API_TOKEN"
else
    echo "API token not supplied; skipping external metric pull." >>"$REPORT_FILE"
fi

# ---------- Completion ----------
echo "Diagnostics completed. Report saved to $REPORT_FILE"
echo "If remediation is required, refer to the sections above and take appropriate actions."
exit 0