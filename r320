#!/usr/bin/env bash
set -euo pipefail

# ----------------------------------------------------------------------
# Script purpose:
#   1. Scan kubelet logs for warnings or errors.
#   2. If logs are clean, verify node status via kubectl.
#   3. If the node is unreachable, confirm it has a valid IP address.
#   4. If the node is reachable but reports a bad condition, restart kubelet.
# ----------------------------------------------------------------------

# Variables --------------------------------------------------------------
NODE_NAME="$(hostname)"                     # Current node hostname
KUBELET_UNIT="kubelet"                      # Systemd unit name
LOG_PRIORITY="warning"                     # Log levels to inspect (warning & above)
MAX_LOG_AGE="1h"                            # How far back to search logs

# Functions --------------------------------------------------------------

log_error() {
    echo "[ERROR] $*" >&2
}

log_info() {
    echo "[INFO] $*"
}

# 1. Examine kubelet logs for warnings/errors
check_kubelet_logs() {
    log_info "Scanning ${KUBELET_UNIT} logs for warnings or errors (last ${MAX_LOG_AGE})..."
    if ! log_output=$(journalctl -u "${KUBELET_UNIT}" -p "${LOG_PRIORITY}" --since="${MAX_LOG_AGE}" --no-pager); then
        log_error "Unable to read journal logs for ${KUBELET_UNIT}."
        return 1
    fi

    if [[ -n "${log_output}" ]]; then
        log_info "Found warnings/errors in kubelet logs:"
        echo "${log_output}"
        return 0
    else
        log_info "No warnings or errors found in kubelet logs."
        return 1
    fi
}

# 2. Verify node status via kubectl
check_node_ready() {
    log_info "Querying node status with kubectl..."
    if ! kubectl_output=$(kubectl get node "${NODE_NAME}" -o json 2>/dev/null); then
        log_error "kubectl could not retrieve information for node '${NODE_NAME}'."
        return 2
    fi

    ready_status=$(echo "${kubectl_output}" |
        jq -r '.status.conditions[] | select(.type=="Ready") | .status')

    if [[ "${ready_status}" == "True" ]]; then
        log_info "Node '${NODE_NAME}' is Ready."
        return 0
    else
        log_info "Node '${NODE_NAME}' is NOT Ready (status=${ready_status})."
        return 1
    fi
}

# 3. Confirm the node has a usable IP address
verify_ip_address() {
    log_info "Inspecting network interfaces for a non‑loopback IP address..."
    ip_list=$(ip -brief addr show | awk '$1 != "lo" {print $3,$4}')

    if [[ -z "${ip_list}" ]]; then
        log_error "No non‑loopback IP address detected on this node."
        return 1
    else
        log_info "Detected IP configuration:"
        echo "${ip_list}"
        return 0
    fi
}

# 4. Restart kubelet service
restart_kubelet_service() {
    log_info "Restarting kubelet service..."
    if ! sudo systemctl restart "${KUBELET_UNIT}"; then
        log_error "Failed to restart ${KUBELET_UNIT}."
        return 1
    fi

    # Give the service a moment to settle
    sleep 5

    if systemctl is-active --quiet "${KUBELET_UNIT}"; then
        log_info "${KUBELET_UNIT} is now active."
        return 0
    else
        log_error "${KUBELET_UNIT} did not become active after restart."
        return 1
    fi
}

# ----------------------------------------------------------------------
# Main execution flow
# ----------------------------------------------------------------------

# Step 1: Look for log problems
if check_kubelet_logs; then
    # Errors/warnings were found – nothing further to do
    exit 0
fi

# Step 2: No log issues → check node readiness
node_check_status=0
if ! node_check_status=$(check_node_ready); then
    # kubectl failure (return code 2) means master can't talk to us
    case $? in
        2)
            log_info "Master node cannot reach this node via kubectl."
            if ! verify_ip_address; then
                log_error "Network configuration problem detected. Fix IP settings and retry."
                exit 1
            fi
            log_info "IP address looks OK. Investigate firewall rules or master‑side networking."
            exit 1
            ;;
        *)
            # Unexpected error
            exit 1
            ;;
    esac
fi

# At this point, node is either Ready (0) or NotReady (1)
if [[ "${node_check_status}" -eq 0 ]]; then
    # Node healthy – nothing else required
    exit 0
else
    # Node reachable but not Ready → verify network then restart kubelet
    if ! verify_ip_address; then
        log_error "Cannot verify network connectivity; aborting."
        exit 1
    fi

    log_info "Node is reachable but reports a bad condition. Attempting kubelet restart..."
    restart_kubelet_service
    exit $?
fi

# End of script