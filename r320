#!/usr/bin/env bash
#
# Processor‑down automated triage & remediation script
# ---------------------------------------------------
# This script implements the run‑book described in the prompt.
# It expects the name of the systemd service (or bare process name)
# that reported the failure and performs diagnostics, attempts
# remediation and validates recovery.
#
# Usage:
#   ./proc_down.sh <service_name> [health_check_url]
#
# Example:
#   ./proc_down.sh myapp-worker.service http://localhost:8080/health
#
# Exit codes:
#   0 – Recovery successful
#   1 – Invalid usage / missing parameters
#   2 – Unable to recover after remedial attempts
#   3 – Critical error while gathering diagnostics

set -euo pipefail

#############################
# Configuration & Defaults #
#############################

# Number of automatic restart attempts before giving up
MAX_RESTART_ATTEMPTS=3

# Time window for journal queries
JOURNAL_SINCE="15 minutes ago"

# Health‑check URL (can be overridden on CLI)
DEFAULT_HEALTH_URL="http://localhost:8080/health"

# Dependencies that must be reachable for the app to work.
# Format: "<service_name>|<host>:<port>"
# e.g. "redis.service|", "db|db01.example.com:5432"
DEPENDENCIES=(
    "redis.service|"
    "db|db01.example.com:5432"
)

# Log directory for this script's own output
SCRIPT_LOG_DIR="/var/tmp/proc_down"
mkdir -p "${SCRIPT_LOG_DIR}"

######################################
# Helper functions – logging & utils #
######################################

log() {
    local level="$1"; shift
    printf '[%s] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*" \
        >>"${SCRIPT_LOG_DIR}/run_$(date '+%Y%m%d').log"
}

die() {
    log "ERROR" "$@"
    exit "${2:-1}"
}

run_cmd() {
    # Executes a command, captures stdout+stderr, returns exit status.
    # Output is logged line‑by‑line.
    local cmd_desc="$1"; shift
    local cmd=("$@")
    log "INFO" "Running: ${cmd_desc}"
    if ! "${cmd[@]}" >>"${SCRIPT_LOG_DIR}/run_$(date '+%Y%m%d').log" 2>&1; then
        log "WARN" "'${cmd_desc}' returned non‑zero exit code"
        return 1
    fi
    return 0
}

#########################
# Argument verification #
#########################

if [[ $# -lt 1 ]]; then
    die "Usage: $0 <service_name> [health_check_url]" 1
fi

SERVICE_NAME="$1"
HEALTH_URL="${2:-$DEFAULT_HEALTH_URL}"

# Derive a simple identifier (strip .service suffix if present)
PROC_ID="${SERVICE_NAME%.service}"

# Path to the primary application log (convention‑based)
APP_LOG="/var/log/${PROC_ID}/worker.log"

####################################
# Diagnostic data collection block #
####################################

collect_diagnostics() {
    local ts now_ts
    now_ts=$(date '+%Y%m%d_%H%M%S')
    DIAG_DIR="${SCRIPT_LOG_DIR}/${PROC_ID}_diag_${now_ts}"
    mkdir -p "${DIAG_DIR}"
    log "INFO" "Collecting diagnostics into ${DIAG_DIR}"

    # 1. Process listing
    ps -ef | grep -i "[${PROC_ID:0:1}]${PROC_ID:1}" >"${DIAG_DIR}/ps.txt" || true

    # 2. Systemd unit status (if applicable)
    if systemctl list-unit-files "${SERVICE_NAME}" >/dev/null 2>&1; then
        systemctl status "${SERVICE_NAME}" >"${DIAG_DIR}/systemd_status.txt" 2>&1 || true
        journalctl -u "${SERVICE_NAME}" --since "${JOURNAL_SINCE}" >"${DIAG_DIR}/journal.txt" 2>&1 || true
    fi

    # 3. Core dump information
    coredumpctl list | grep -i "${PROC_ID}" >"${DIAG_DIR}/coredumps.txt" 2>&1 || true

    # 4. Top snapshot (resource pressure)
    top -b -n1 | head -20 >"${DIAG_DIR}/top_snapshot.txt" 2>&1

    # 5. Disk utilisation for typical mount points
    df -h /var/log /opt/"${PROC_ID}" >"${DIAG_DIR}/df.txt" 2>&1 || true

    # 6. Tail of application log (if exists)
    if [[ -f "${APP_LOG}" ]]; then
        tail -n100 "${APP_LOG}" >"${DIAG_DIR}/app_log_tail.txt" 2>&1
    else
        echo "Log file not found: ${APP_LOG}" >"${DIAG_DIR}/app_log_tail.txt"
    fi

    # 7. Dependency status & connectivity
    for dep in "${DEPENDENCIES[@]}"; do
        IFS='|' read -r dep_service dep_target <<<"$dep"
        if [[ -n "${dep_service}" ]]; then
            systemctl status "${dep_service}" >"${DIAG_DIR}/dep_${dep_service}.txt" 2>&1 || true
        fi
        if [[ -n "${dep_target}" ]]; then
            host_port=(${dep_target//:/ })
            nc -zvw2 "${host_port[0]}" "${host_port[1]}" >"${DIAG_DIR}/dep_${host_port[0]}_${host_port[1]}.txt" 2>&1 || true
        fi
    done

    # 8. Health‑check endpoint
    curl -s -o /dev/null -w "%{http_code}" "${HEALTH_URL}" >"${DIAG_DIR}/health_httpcode.txt" 2>&1 || true
}

###################################
# Remediation helper sub‑routines #
###################################

restart_service() {
    local attempts=0
    while (( attempts < MAX_RESTART_ATTEMPTS )); do
        ((attempts++))
        log "INFO" "Attempt ${attempts} to start ${SERVICE_NAME}"
        if run_cmd "systemctl start ${SERVICE_NAME}" systemctl start "${SERVICE_NAME}"; then
            sleep 5  # give it a moment to settle
            if is_process_running; then
                log "INFO" "${SERVICE_NAME} started successfully."
                return 0
            fi
        fi
        log "WARN" "Start attempt ${attempts} failed."
        sleep 10
    done
    return 1
}

is_process_running() {
    # Returns 0 if at least one matching process is found
    if pgrep -f "[${PROC_ID:0:1}]${PROC_ID:1}" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

increase_ulimit() {
    log "INFO" "Increasing file‑descriptor limit to 65536 for current shell"
    ulimit -n 65536 || log "WARN" "Failed to raise ulimit"
}

revert_config() {
    local cfg_path="/etc/${PROC_ID}/worker.yaml"
    if [[ -f "${cfg_path}" && -d "/etc/${PROC_ID}/.git" ]]; then
        log "INFO" "Reverting configuration to previous git revision"
        pushd "/etc/${PROC_ID}" >/dev/null
        git checkout HEAD~1 -- worker.yaml || log "WARN" "Git revert failed"
        popd >/dev/null
        systemctl reload "${SERVICE_NAME}" || log "WARN" "Reload failed"
    else
        log "WARN" "Config revert not possible – missing repo or file"
    fi
}

clean_old_logs() {
    local log_dir="/var/log/${PROC_ID}"
    if [[ -d "${log_dir}" ]]; then
        log "INFO" "Cleaning logs older than 30 days under ${log_dir}"
        find "${log_dir}" -type f -mtime +30 -delete || log "WARN" "Old‑log cleanup failed"
    fi
}

restart_dependency() {
    local dep_service="$1"
    log "INFO" "Restarting dependency ${dep_service}"
    systemctl restart "${dep_service}" || log "WARN" "Failed to restart ${dep_service}"
}

#################################
# Main execution flow – Triage  #
#################################

main() {
    log "INFO" "=== Processor‑down runbook invoked for ${SERVICE_NAME} ==="

    collect_diagnostics

    if is_process_running; then
        log "INFO" "Process appears to be running. Performing health‑check."

        http_code=$(cat "${SCRIPT_LOG_DIR}/${PROC_ID}_diag_"*/health_httpcode.txt 2>/dev/null || echo "")
        if [[ "${http_code}" == "200" ]]; then
            log "INFO" "Health endpoint reports OK (HTTP 200). No further action required."
            exit 0
        else
            log "WARN" "Health endpoint returned '${http_code}'. Proceeding with remediation."
        fi
    else
        log "WARN" "Process not found. Initiating start sequence."
    fi

    # Attempt basic remediation steps
    increase_ulimit
    if ! restart_service; then
        log "ERROR" "Service failed to start after ${MAX_RESTART_ATTEMPTS} attempts."
        # Try auxiliary remediation paths
        revert_config
        clean_old_logs
        # Restart common dependencies (example: redis)
        for dep in "${DEPENDENCIES[@]}"; do
            IFS='|' read -r dep_service _ <<<"$dep"
            if [[ -n "${dep_service}" ]]; then
                restart_dependency "${dep_service}"
            fi
        done
        # Final start attempt
        if ! restart_service; then
            log "CRITICAL" "Unable to recover ${SERVICE_NAME}. Escalation required."
            exit 2
        fi
    fi

    # Post‑remediation validation
    if is_process_running; then
        pid=$(pgrep -f "[${PROC_ID:0:1}]${PROC_ID:1}" | head -n1)
        uptime=$(ps -p "${pid}" -o etime=)
        log "INFO" "Process ${PROC_ID} (PID ${pid}) uptime: ${uptime}"
    else
        log "ERROR" "Process still not visible after remediation."
        exit 2
    fi

    # Re‑run health‑check
    if curl -s -o /dev/null -w "%{http_code}" "${HEALTH_URL}" | grep -q "^200$"; then
        log "INFO" "Health‑check succeeded (HTTP 200). Recovery complete."
    else
        log "WARN" "Health‑check still failing. Monitoring will continue."
    fi

    # Suppress duplicate alerts for a short window (optional)
    touch "${SCRIPT_LOG_DIR}/${PROC_ID}_last_success"
    log "INFO" "Runbook completed successfully."
    exit 0
}

main "$@"