#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Script to diagnose a Kubernetes node issue:
#   1) Scan recent kubelet logs for errors or warnings.
#   2) Verify node presence and status via `kubectl get nodes`.
#   3) If node absent, confirm the node has a non‑loopback IP.
#   4) If node present but not Ready, restart the kubelet service.
# ------------------------------------------------------------

# Configuration
KUBELET_UNIT="kubelet"
LOG_TIMEFRAME="1h"          # How far back to search logs (e.g., 1h, 30m)
MAX_LOG_LINES=1000           # Limit log output size when printing matches
KUBECTL_CMD="${KUBECTL_CMD:-kubectl}"   # Allow override via env var

# Helper: print timestamped messages
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${1^^}] $2"
}

# ------------------------------------------------------------------
# Step 1 – Search kubelet logs for errors or warnings
# ------------------------------------------------------------------
log "info" "Scanning ${KUBELET_UNIT} logs for errors/warnings (last ${LOG_TIMEFRAME})..."
if ! command -v journalctl >/dev/null 2>&1; then
    log "error" "journalctl not available; cannot read systemd logs."
    exit 1
fi

# Capture matching lines (case‑insensitive)
mapfile -t log_matches < <(
    journalctl -u "${KUBELET_UNIT}" --since "-${LOG_TIMEFRAME}" \
        | grep -iE "(error|warning)" || true
)

if (( ${#log_matches[@]} > 0 )); then
    log "warn" "Found ${#log_matches[@]} error/warning entries in ${KUBELET_UNIT} logs:"
    printf '%s\n' "${log_matches[@]:0:${MAX_LOG_LINES}}" | sed 's/^/    /'
    log "info" "Investigate the above log entries before proceeding."
    exit 0
else
    log "info" "No error or warning messages detected in recent ${KUBELET_UNIT} logs."
fi

# ------------------------------------------------------------------
# Step 2 – Verify node appears in `kubectl get nodes`
# ------------------------------------------------------------------
NODE_NAME="$(hostname)"
log "info" "Checking node '${NODE_NAME}' status via ${KUBECTL_CMD}..."

if ! command -v "${KUBECTL_CMD}" >/dev/null 2>&1; then
    log "error" "'${KUBECTL_CMD}' command not found. Ensure kubectl is installed and in PATH."
    exit 1
fi

# Get node list in plain text, suppress headers for easier parsing
node_line="$(${KUBECTL_CMD} get nodes -o wide | awk -v n="${NODE_NAME}" '$1==n {print}')"

if [[ -z "$node_line" ]]; then
    log "error" "Node '${NODE_NAME}' not listed by '${KUBECTL_CMD}'. It may be unreachable from the control plane."

    # ------------------------------------------------------------------
    # Step 3 – Verify the node has a usable IP address
    # ------------------------------------------------------------------
    log "info" "Inspecting network interfaces for a non‑loopback IP address..."
    ip_output=$(ip -brief addr show up primary scope global)

    if [[ -z "$ip_output" ]]; then
        log "error" "No active non‑loopback network interface detected."
        exit 1
    else
        log "info" "Active interfaces with IPs:"
        echo "$ip_output" | while read -r iface addrs; do
            echo "    $iface: $addrs"
        done
        log "info" "Ensure the node can reach the API server/network."
    fi
    exit 1
fi

# Extract the STATUS column (second field)
node_status=$(echo "$node_line" | awk '{print $2}')
log "info" "Node '${NODE_NAME}' reported status: ${node_status}"

# ------------------------------------------------------------------
# Step 4 – If status is not Ready, attempt to restart kubelet
# ------------------------------------------------------------------
if [[ "$node_status" != "Ready" ]]; then
    log "warn" "Node status is not Ready (current: ${node_status}). Attempting to restart ${KUBELET_UNIT}..."

    if ! command -v systemctl >/dev/null 2>&1; then
        log "error" "systemctl not available; cannot manage services."
        exit 1
    fi

    sudo systemctl restart "${KUBELET_UNIT}"
    log "info" "Restarted ${KUBELET_UNIT}. Waiting briefly for it to settle..."
    sleep 15

    # Re‑query node status
    refreshed_line="$(${KUBECTL_CMD} get nodes -o wide | awk -v n="${NODE_NAME}" '$1==n {print}')"
    refreshed_status=$(echo "$refreshed_line" | awk '{print $2}')

    if [[ "$refreshed_status" == "Ready" ]]; then
        log "info" "Node '${NODE_NAME}' is now Ready after restarting ${KUBELET_UNIT}."
        exit 0
    else
        log "error" "Node remains in '${refreshed_status}' state after restart. Further investigation required."
        exit 1
    fi
else
    log "info" "Node '${NODE_NAME}' is Healthy (Ready). No further action needed."
    exit 0
fi