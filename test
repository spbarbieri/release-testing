#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Script to diagnose a problematic Kubernetes worker node.
# It performs:
#   1) Scan recent kubelet logs for errors or warnings.
#   2) Verify node presence and status via `kubectl get nodes`.
#   3) If node missing, confirm the node has a valid IP address.
#   4) If node present but not Ready, restart the kubelet service.
# ------------------------------------------------------------

LOG_DAYS_AGO=1               # How far back to look in the logs (in days)
KUBELET_UNIT="kubelet"
NODE_NAME="$(hostname -s)"
KUBECTL_CMD="${KUBECTL_CMD:-kubectl}"   # Allow overriding via env var

# Function: Print a timestamped message
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*"
}

# ------------------------------------------------------------------
# Step 1 – Look for errors or warnings in recent kubelet logs
# ------------------------------------------------------------------
log "Checking ${KUBELET_UNIT} logs for errors or warnings (last ${LOG_DAYS_AGO} day(s))..."
if journalctl -u "${KUBELET_UNIT}" --since "${LOG_DAYS_AGO} day ago" \
        | grep -iE "(error|warning)" >/dev/null; then
    log "⚠️  Errors or warnings detected in ${KUBELET_UNIT} logs."
    journalctl -u "${KUBELET_UNIT}" --since "${LOG_DAYS_AGO} day ago" \
        | grep -iE "(error|warning)" | tail -n 20
    exit 0
else
    log "✅ No error or warning entries found in ${KUBELET_UNIT} logs."
fi

# ------------------------------------------------------------------
# Step 2 – Verify node visibility and health via kubectl
# ------------------------------------------------------------------
log "Querying cluster state with '${KUBECTL_CMD} get nodes'..."
if ! NODE_TABLE="$(${KUBECTL_CMD} get nodes -o wide 2>/dev/null)"; then
    log "❌ Unable to communicate with the Kubernetes API server."
    exit 1
fi

# Extract the line corresponding to this node
NODE_LINE=$(echo "$NODE_TABLE" | awk -v n="${NODE_NAME}" '$1==n')
if [[ -z "$NODE_LINE" ]]; then
    log "🚫 Node '${NODE_NAME}' not listed in 'kubectl get nodes' output."
    
    # ------------------------------------------------------------------
    # Step 3 – Check network configuration (IP address assignment)
    # ------------------------------------------------------------------
    log "Inspecting network interfaces on the node..."
    if ip addr show | grep -qE '\binet\s+[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+'; then
        log "✅ An IP address is configured on at least one interface."
    else
        log "❌ No IPv4 address found on any interface. Network mis‑configuration suspected."
    fi
    exit 0
fi

# Parse the STATUS column (second field)
STATUS=$(echo "$NODE_LINE" | awk '{print $2}')
log "Node '${NODE_NAME}' reported status: ${STATUS}"

# ------------------------------------------------------------------
# Step 4 – If node is not Ready, attempt to recover by restarting kubelet
# ------------------------------------------------------------------
if [[ "$STATUS" != "Ready" ]]; then
    log "Node status is not Ready. Attempting to restart the kubelet service..."
    if systemctl restart "${KUBELET_UNIT}"; then
        log "✅ kubelet restarted successfully. Rechecking node status..."
        sleep 10   # give the node a moment to re‑register
        NEW_STATUS=$(${KUBECTL_CMD} get node "${NODE_NAME}" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')
        if [[ "$NEW_STATUS" == "True" ]]; then
            log "🎉 Node is now Ready."
        else
            log "⚠️ Node remains not Ready after kubelet restart. Further investigation required."
        fi
    else
        log "❌ Failed to restart kubelet. Manual intervention needed."
        exit 1
    fi
else
    log "✅ Node is already in Ready state. No further action required."
fi

exit 0