#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Script: diagnose_k8s_node.sh
# Purpose: Diagnose a Kubernetes worker node issues:
#   1) Scan recent kubelet logs for errors/warnings.
#   2) Verify node presence and status via kubectl.
#   3) Validate network interface configuration.
#   4) Restart kubelet if needed.
# ------------------------------------------------------------

# Configurable parameters
LOG_LOOKBACK="1h"          # How far back to look into logs (e.g., 1h, 30m)
KUBELET_SERVICE="kubelet"
MAX_RESTART_ATTEMPTS=1

# Helper functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $*"
}
warn() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [WARN] $*" >&2
}
err() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $*" >&2
    exit 1
}

# Ensure required commands are available
for cmd in journalctl kubectl ip awk grep systemctl hostname; do
    command -v "$cmd" >/dev/null 2>&1 || err "Required command '$cmd' not found in PATH."
done

# Determine the node's name (assume hostname matches the node name in k8s)
NODE_NAME="$(hostname)"
log "Diagnosing node: $NODE_NAME"

# ------------------------------------------------------------
# Step 1: Inspect kubelet logs for errors or warnings
# ------------------------------------------------------------
log "Scanning recent kubelet logs for errors or warnings..."
if LOG_OUTPUT=$(journalctl -u "$KUBELET_SERVICE" --since "$LOG_LOOKBACK" 2>/dev/null); then
    ERR_WARN_LINES=$(echo "$LOG_OUTPUT" | grep -iE "(error|warning)" || true)
    if [[ -n "$ERR_WARN_LINES" ]]; then
        warn "Found error/warning entries in kubelet logs:"
        echo "$ERR_WARN_LINES"
        exit 0
    else
        log "No error or warning messages found in recent kubelet logs."
    fi
else
    warn "Unable to retrieve kubelet logs via journalctl; skipping log inspection."
fi

# ------------------------------------------------------------
# Step 2: Verify node status via kubectl
# ------------------------------------------------------------
log "Fetching node list from the control plane..."
if ! KUBECTL_OUTPUT=$(kubectl get nodes -o wide 2>/dev/null); then
    err "Failed to execute 'kubectl get nodes'. Ensure kubectl is configured correctly."
fi

# Extract the line corresponding to this node
NODE_LINE=$(echo "$KUBECTL_OUTPUT" | awk -v n="$NODE_NAME" '$1==n')
if [[ -z "$NODE_LINE" ]]; then
    warn "Node '$NODE_NAME' is not listed in 'kubectl get nodes' output – appears unreachable from the master."
    REACHABLE=false
else
    NODE_STATUS=$(echo "$NODE_LINE" | awk '{print $2}')
    log "Node status reported as: $NODE_STATUS"
    REACHABLE=true
fi

# ------------------------------------------------------------
# Step 3: Network connectivity check (only if node not reachable)
# ------------------------------------------------------------
if [[ "${REACHABLE:-false}" = false ]]; then
    log "Checking network interfaces for assigned IP addresses..."
    IP_INFO=$(ip -brief address show up primary scope global)
    if [[ -z "$IP_INFO" ]]; then
        err "No active non‑loopback IP address detected on this node."
    else
        log "Active network interfaces with IPs:"
        echo "$IP_INFO"
    fi
    # After confirming IP, advise user to investigate networking further
    warn "Node still not visible to the control plane despite having an IP. Investigate firewall rules, CNI plugins, etc."
    exit 0
fi

# ------------------------------------------------------------
# Step 4: Evaluate node condition and possibly restart kubelet
# ------------------------------------------------------------
if [[ "$NODE_STATUS" != "Ready" ]]; then
    log "Node is reachable but not in Ready state (Status=$NODE_STATUS). Attempting to remediate."

    attempt=0
    while (( attempt < MAX_RESTART_ATTEMPTS )); do
        ((attempt++))
        log "Restarting kubelet service (attempt $attempt)..."
        if systemctl restart "$KUBELET_SERVICE"; then
            log "kubelet restarted successfully. Waiting briefly for status update..."
            sleep 15
            # Re‑query node status
            NEW_STATUS=$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "Unknown")
            if [[ "$NEW_STATUS" == "True" ]]; then
                log "Node has transitioned to Ready state after restart."
                exit 0
            else
                warn "Node still not Ready (Ready condition = $NEW_STATUS)."
            fi
        else
            warn "Failed to restart kubelet on attempt $attempt."
        fi
    done

    err "Node remains in a bad condition after $MAX_RESTART_ATTEMPTS restart attempts. Manual investigation required."
else
    log "Node is healthy and in Ready state. No further action required."
fi

exit 0