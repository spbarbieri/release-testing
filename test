#!/bin/bash
# Define a threshold for CPU usage (e.g., 10%)
CPU_THRESHOLD=10

# Use ps aux to get CPU usage of all running processes
# The output is piped to awk to filter out the process name and CPU usage
# The CPU usage is calculated as (percentage of CPU used / total CPUs) * 100
# We then filter processes using more than the defined threshold
PROCESSES=$(ps aux | awk '{print $2, $11}' | awk -F'%' '{print $1 * $2 / 100}')

# Find processes using more CPU than the threshold
# We use grep to filter out lines with more than the threshold
# The output is then piped to cut to extract only the process name
SUSPICIOUS_PROCESSES=$(echo "$PROCESSES" | awk -v threshold="$CPU_THRESHOLD" '$1 > threshold {print $0}')

# If there are suspicious processes, print them and offer to stop them
if [ -n "$SUSPICIOUS_PROCESSES" ]; then
    echo "The following processes are using more than $CPU_THRESHOLD% CPU:"
    echo "$SUSPICIOUS_PROCESSES"
    read -p "Do you want to stop any of them? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        read -p "Enter the process name to stop: " PROCESS_NAME
        for PROCESS in $SUSPICIOUS_PROCESSES; do
            if [[ $PROCESS == *"$PROCESS_NAME"* ]]; then
                echo "Stopping process: $PROCESS_NAME"
                # Use kill command to send SIGTERM to the process
                # Replace with kill -9 if you want to forcefully kill the process
                kill $(ps aux | grep "$PROCESS_NAME" | awk '{print $2}')
                break
            fi
        done
    fi
else
    echo "No processes are using more than $CPU_THRESHOLD% CPU."
fi

