#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Script: diagnose_k8s_node.sh
# Purpose: Diagnose common issues on a Kubernetes worker node.
# Steps:
#   1. Scan recent kubelet logs for errors or warnings.
#   2. Verify node status via 'kubectl get nodes'.
#   3. If node is unreachable, confirm the node has a valid IP.
#   4. If node is reachable but in a bad condition, restart kubelet.
# ------------------------------------------------------------

# Configurable parameters
LOG_LOOKBACK="1h"               # How far back to search logs (compatible with journalctl)
KUBELET_UNIT="kubelet"
MAX_LOG_LINES=1000              # Limit displayed log lines when errors are found

# Helper functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $*"
}
err() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $*" >&2
}
die() {
    err "$@"
    exit 1
}

# 1. Check kubelet logs for errors or warnings
log "Scanning ${KUBELET_UNIT} logs for errors or warnings (last ${LOG_LOOKBACK})..."
if command -v journalctl >/dev/null 2>&1; then
    LOG_OUTPUT=$(journalctl -u "${KUBELET_UNIT}" --since="${LOG_LOOKBACK}" \
        | grep -Ei "(error|warn)" || true)
else
    die "journalctl not available; cannot read ${KUBELET_UNIT} logs."
fi

if [[ -n "${LOG_OUTPUT}" ]]; then
    err "Found error/warning entries in ${KUBELET_UNIT} logs:"
    echo "${LOG_OUTPUT}" | tail -n "${MAX_LOG_LINES}"
    exit 2
else
    log "No error or warning messages detected in recent ${KUBELET_UNIT} logs."
fi

# 2. Verify node status via kubectl
if ! command -v kubectl >/dev/null 2>&1; then
    die "kubectl command not found in PATH."
fi

NODE_NAME="$(hostname -s)"
log "Checking node status for '${NODE_NAME}' using 'kubectl get nodes'..."
NODE_STATUS_LINE=$(kubectl get nodes "${NODE_NAME}" -o wide 2>/dev/null || true)

if [[ -z "${NODE_STATUS_LINE}" ]]; then
    err "Node '${NODE_NAME}' not listed by the control plane."
    NODE_REACHABLE=false
else
    # Expected columns: NAME STATUS ... ; extract STATUS column (2nd field)
    NODE_STATUS=$(echo "${NODE_STATUS_LINE}" | awk '{print $2}')
    log "Node status reported as '${NODE_STATUS}'."
    case "${NODE_STATUS}" in
        Ready) NODE_REACHABLE=true ;;
        *)     NODE_REACHABLE=false ;;
    esac
fi

# 3. If node not reachable, verify network configuration
if [[ "${NODE_REACHABLE}" = false ]]; then
    log "Attempting to verify network interface configuration..."
    IP_INFO=$(ip -4 addr show scope global up | awk '/inet/ {print $2}' | head -n1 || true)

    if [[ -z "${IP_INFO}" ]]; then
        err "No IPv4 address found on any non‑loopback interface."
        err "Network configuration issue likely; please assign an IP address."
        exit 3
    else
        log "Detected IP address: ${IP_INFO}"
        err "Node appears reachable at network level but not recognized by the master."
        err "Possible causes: firewall rules, kubelet misconfiguration, or API server access."
        # Continue to attempt remediation (restart kubelet) as a last resort
    fi
fi

# 4. If node reachable but still in bad condition, restart kubelet
if [[ "${NODE_REACHABLE}" = false ]]; then
    log "Restarting ${KUBELET_UNIT} service to recover node condition..."
    if systemctl is-active --quiet "${KUBELET_UNIT}"; then
        sudo systemctl restart "${KUBELET_UNIT}"
        log "${KUBELET_UNIT} restarted successfully."
    else
        err "${KUBELET_UNIT} service is not active; attempting to start it."
        sudo systemctl start "${KUBELET_UNIT}"
        log "${KUBELET_UNIT} started successfully."
    fi

    # Give kubelet a moment to re-register
    sleep 10
    log "Rechecking node status after kubelet restart..."
    NEW_STATUS_LINE=$(kubectl get nodes "${NODE_NAME}" -o wide 2>/dev/null || true)
    if [[ -n "${NEW_STATUS_LINE}" ]]; then
        NEW_STATUS=$(echo "${NEW_STATUS_LINE}" | awk '{print $2}')
        log "Post‑restart node status: ${NEW_STATUS}"
        if [[ "${NEW_STATUS}" == "Ready" ]]; then
            log "Node recovered successfully."
            exit 0
        else
            err "Node still not ready after kubelet restart."
            exit 4
        fi
    else
        err "Node still absent from 'kubectl get nodes' after kubelet restart."
        exit 5
    fi
else
    log "Node '${NODE_NAME}' is already in Ready state. No action required."
    exit 0
fi