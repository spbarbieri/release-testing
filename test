#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# Script: diagnose_k8s_node.sh
# Purpose: Diagnose common issues on a Kubernetes worker node.
# Steps:
#   1) Scan recent kubelet logs for errors or warnings.
#   2) Verify node status via 'kubectl get nodes'.
#   3) If node is NotReady, confirm the node has a valid IP address.
#   4) If the node is reachable but still unhealthy, restart kubelet.
# ------------------------------------------------------------

# Configurable parameters
LOG_LOOKBACK="1h"               # How far back to search logs (compatible with journalctl)
KUBELET_UNIT="kubelet"
MAX_LOG_LINES=1000              # Limit lines processed when searching logs
IP_INTERFACE_REGEX='^[0-9]+:'   # Pattern to identify interface entries in ip addr output

# Helper functions ------------------------------------------------
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $*"
}
err() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $*" >&2
}
die() {
    err "$@"
    exit 1
}

# 1) Check kubelet logs for errors or warnings -----------------
log "Scanning recent ${KUBELET_UNIT} logs for errors or warnings..."
if ! command -v journalctl >/dev/null 2>&1; then
    die "journalctl not found – cannot read systemd logs."
fi

# Capture relevant log lines (limit to avoid huge output)
log_output=$(journalctl -u "${KUBELET_UNIT}" --since="${LOG_LOOKBACK}" -n "${MAX_LOG_LINES}" || true)

if [[ -z "${log_output}" ]]; then
    log "No recent ${KUBELET_UNIT} logs found."
else
    # Search case‑insensitively for typical keywords
    if echo "${log_output}" | grep -iE 'error|warn|failed|panic' >/dev/null; then
        err "Found error/warning entries in ${KUBELET_UNIT} logs:"
        echo "${log_output}" | grep -iE 'error|warn|failed|panic'
        exit 1
    else
        log "No error or warning messages detected in recent logs."
    fi
fi

# 2) Verify node status via kubectl -----------------------------
if ! command -v kubectl >/dev/null 2>&1; then
    die "kubectl not installed or not in PATH."
fi

NODE_NAME="$(hostname)"
log "Checking node '${NODE_NAME}' status with 'kubectl get nodes'..."

# Get the line corresponding to this node
node_line=$(kubectl get nodes "${NODE_NAME}" --no-headers 2>/dev/null || true)

if [[ -z "${node_line}" ]]; then
    err "Node '${NODE_NAME}' not listed in 'kubectl get nodes'. It may be unreachable from the control plane."
    REACHABLE=false
else
    # Expected columns: NAME STATUS ... ; we care about the second column
    NODE_STATUS=$(awk '{print $2}' <<<"${node_line}")
    log "Node status reported as '${NODE_STATUS}'."

    if [[ "${NODE_STATUS}" == "Ready" ]]; then
        log "Node is healthy. No further action required."
        exit 0
    else
        log "Node is not Ready (status: ${NODE_STATUS}). Proceeding with deeper checks."
        REACHABLE=true
    fi
fi

# 3) If node not reachable, verify it has a usable IP address --
if [[ "${REACHABLE:-true}" = false ]]; then
    log "Verifying network configuration on the node..."
    if ! command -v ip >/dev/null 2>&1; then
        die "'ip' command not available."
    fi

    ip_info=$(ip -brief addr show)
    # Filter out loopback and down interfaces
    usable_ip=$(echo "${ip_info}" |
                awk '$3 != "LOOPBACK" && $3 != "DOWN" {for(i=3;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $i}' |
                head -n1 || true)

    if [[ -z "${usable_ip}" ]]; then
        err "No non‑loopback IPv4 address found on this node. Network misconfiguration suspected."
        exit 1
    else
        log "Detected IP address ${usable_ip}. Node appears to have networking; issue may lie elsewhere."
    fi
fi

# 4) Node reachable but still unhealthy → restart kubelet ----------
log "Attempting to restart the kubelet service to recover node health..."
if ! command -v systemctl >/dev/null 2>&1; then
    die "systemctl not found – cannot manage services."
fi

sudo systemctl restart "${KUBELET_UNIT}"
log "kubelet restarted. Waiting briefly for it to settle..."
sleep 10

# Re‑check node status after restart
log "Re‑checking node status post‑restart..."
node_line_post=$(kubectl get nodes "${NODE_NAME}" --no-headers 2>/dev/null || true)
if [[ -z "${node_line_post}" ]]; then
    err "Node still not visible to the control plane after kubelet restart."
    exit 1
fi
POST_STATUS=$(awk '{print $2}' <<<"${node_line_post}")

if [[ "${POST_STATUS}" == "Ready" ]]; then
    log "Node status is now Ready. Issue resolved."
    exit 0
else
    err "Node remains in status '${POST_STATUS}' after kubelet restart."
    exit 1
fi