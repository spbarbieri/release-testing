#!/bin/bash
# This script checks network devices for potential issues, such as bad segments received.
# It uses the 'ping' command to send ICMP echo requests to a list of network devices.
# If a device does not respond, it will print a message indicating the device is unreachable.
# If a device responds but with a high packet loss rate, it will print a warning message.

# List of network devices to check
devices=("192.168.1.1" "192.168.1.2" "192.168.1.3")

# Loop through each device
for device in "${devices[@]}"; do
    # Use 'ping' to check if the device is reachable
    response=$(ping -c 1 -W 1 $device | grep '1 received')
    
    # If no response, print a message indicating the device is unreachable
    if [ "$response" == "" ]; then
        echo "Device $device is unreachable."
    # If response indicates packet loss, print a warning message
    elif echo "$response" | grep -q '1 received'; then
        echo "Warning: High packet loss detected on $device."
    fi
done