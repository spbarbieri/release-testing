#!/bin/bash
set -euo pipefail

#====================================================================
# Script: incident_analysis.sh
# Purpose: Automate investigation of unexpected errors, metric anomalies,
#          recent changes review, stress testing, and optional rollback.
# Author: Automated Generation
#====================================================================

#--------------------------- Configuration ---------------------------
# Directories & Files
LOG_DIR="/var/log"
NETWORK_LOGS=("$LOG_DIR/syslog" "$LOG_DIR/kern.log" "$LOG_DIR/messages")
METRIC_SNAPSHOT="/tmp/metric_snapshot.txt"
CHANGE_LOGS=("/var/log/dpkg.log" "/var/log/yum.log" "/var/log/apt/history.log")
STRESS_DURATION="60"   # seconds
STRESS_CPU="2"         # number of CPU workers for stress test
REPORT_DIR="/tmp/incident_report"
PLUGIN_NAME="example-plugin"
SUPPORT_EMAIL="support@example.com"

# Ensure report directory exists
mkdir -p "$REPORT_DIR"

#--------------------------- Helper Functions -------------------------

error_exit() {
    echo "ERROR: $*" >&2
    exit 1
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

#--------------------------- Step 1: Network Log Analysis -------------

analyze_network_logs() {
    local out_file="$REPORT_DIR/network_errors.txt"
    echo "Analyzing network traffic logs..." >"$out_file"
    
    for log in "${NETWORK_LOGS[@]}"; do
        if [[ -f "$log" ]]; then
            # Extract lines containing typical error keywords and pull source IPs
            grep -iE "error|failed|unreachable|timeout" "$log" | \
                awk '
                    {
                        # Try to match IPv4 addresses in the line
                        for(i=1;i<=NF;i++) {
                            if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
                                ip=$i;
                                break;
                            }
                        }
                        print "["FILENAME"]", $0, "SRC_IP="ip
                    }' >>"$out_file"
        else
            echo "Log file $log not found, skipping." >>"$out_file"
        fi
    done
    
    echo "Network log analysis saved to $out_file"
}

#--------------------------- Step 2: System Metrics Check -------------

collect_system_metrics() {
    local out_file="$REPORT_DIR/system_metrics.txt"
    echo "Collecting current system metrics..." >"$out_file"
    
    # CPU usage snapshot
    echo "--- CPU Usage (top -b -n1) ---" >>"$out_file"
    top -b -n1 | head -15 >>"$out_file"
    
    # Memory usage
    echo -e "\n--- Memory Usage (free -h) ---" >>"$out_file"
    free -h >>"$out_file"
    
    # Disk I/O
    echo -e "\n--- Disk I/O (iostat -dx 1 3) ---" >>"$out_file"
    if command_exists iostat; then
        iostat -dx 1 3 >>"$out_file"
    else
        echo "iostat not installed." >>"$out_file"
    fi
    
    # Network statistics
    echo -e "\n--- Network Stats (ss -s) ---" >>"$out_file"
    ss -s >>"$out_file"
    
    echo "System metrics collected in $out_file"
}

detect_metric_anomalies() {
    local src_file="$REPORT_DIR/system_metrics.txt"
    local out_file="$REPORT_DIR/metric_anomalies.txt"
    echo "Scanning metrics for potential anomalies..." >"$out_file"
    
    # Simple heuristic: look for CPU usage >80% idle low, memory usage >90%, disk wait >10ms
    if grep -q "Cpu(s):.*id," "$src_file"; then
        cpu_idle=$(grep "Cpu(s):" "$src_file" | awk -F',' '{for(i=1;i<=NF;i++){if($i~/ id/){gsub(/[[:space:]%]*/,"",$i);print $i}}}')
        cpu_usage=$((100 - cpu_idle))
        if (( cpu_usage > 80 )); then
            echo "High CPU usage detected: ${cpu_usage}%." >>"$out_file"
        fi
    fi
    
    if grep -q "Mem:" "$src_file"; then
        mem_used=$(grep "Mem:" "$src_file" | awk '{print $3}' | sed 's/[A-Za-z]*//')
        mem_total=$(grep "Mem:" "$src_file" | awk '{print $2}' | sed 's/[A-Za-z]*//')
        mem_perc=$(( 100 * mem_used / mem_total ))
        if (( mem_perc > 90 )); then
            echo "High memory utilization detected: ${mem_perc}%." >>"$out_file"
        fi
    fi
    
    if grep -q "await" "$src_file"; then
        await=$(grep "await" "$src_file" | tail -1 | awk '{print $(NF-1)}')
        # assume value is in ms
        if (( $(echo "$await > 10" | bc -l) )); then
            echo "Disk average wait time high: ${await} ms." >>"$out_file"
        fi
    fi
    
    echo "Anomaly detection complete. Results stored in $out_file"
}

#--------------------------- Step 3: Recent Changes Review -----------

review_recent_changes() {
    local out_file="$REPORT_DIR/recent_changes.txt"
    echo "Gathering recent change information..." >"$out_file"
    
    for changelog in "${CHANGE_LOGS[@]}"; do
        if [[ -f "$changelog" ]]; then
            echo "---- $changelog (last 24h) ----" >>"$out_file"
            # Show entries from the last day
            awk -v d="$(date --date='1 day ago' '+%Y-%m-%d')" '$0 >= d' "$changelog" >>"$out_file" || true
        else
            echo "Change log $changelog not present." >>"$out_file"
        fi
    done
    
    # Git repository changes (if any)
    if [[ -d "/opt/infrastructure_repo/.git" ]]; then
        echo -e "\n---- Git Repository Recent Commits (last 5) ----" >>"$out_file"
        git -C /opt/infrastructure_repo log -5 --oneline >>"$out_file"
    else
        echo -e "\nNo Git repository detected at /opt/infrastructure_repo." >>"$out_file"
    fi
    
    echo "Recent changes recorded in $out_file"
}

#--------------------------- Step 4: Stress Testing ------------------

run_stress_test() {
    local out_file="$REPORT_DIR/stress_test.txt"
    echo "Starting stress test (duration=${STRESS_DURATION}s, cpu_workers=${STRESS_CPU})..." >"$out_file"
    
    if ! command_exists stress-ng; then
        echo "stress-ng not installed. Attempting to install via package manager." >>"$out_file"
        if command_exists apt-get; then
            sudo apt-get update && sudo apt-get install -y stress-ng
        elif command_exists yum; then
            sudo yum install -y stress-ng
        else
            error_exit "Cannot install stress-ng: unsupported package manager."
        fi
    fi
    
    # Run stress in background while capturing system metrics concurrently
    stress-ng --cpu "$STRESS_CPU" --timeout "${STRESS_DURATION}s" --metrics-brief >>"$out_file" 2>&1 &
    STRESS_PID=$!
    
    # While stress runs, sample top every 5 seconds
    echo "Sampling system state during stress..." >>"$out_file"
    for ((i=0; i<STRESS_DURATION; i+=5)); do
        echo "--- Top snapshot @ $(date +'%H:%M:%S') ---" >>"$out_file"
        top -b -n1 | head -12 >>"$out_file"
        sleep 5
    done
    
    wait "$STRESS_PID"
    echo "Stress test completed." >>"$out_file"
    echo "Stress test details saved to $out_file"
}

#--------------------------- Step 5: Documentation / Support ----------

consult_documentation() {
    local doc_url="https://docs.example.com/plugins/${PLUGIN_NAME}"
    local out_file="$REPORT_DIR/plugin_support.txt"
    
    echo "Fetching latest documentation for plugin '${PLUGIN_NAME}'..." >"$out_file"
    if command_exists curl; then
        curl -fsSL "$doc_url" | head -20 >>"$out_file" || echo "Failed to retrieve documentation." >>"$out_file"
    else
        echo "curl not available; cannot fetch online docs." >>"$out_file"
    fi
    
    echo -e "\nIf further assistance is required, consider contacting support:\nEmail: $SUPPORT_EMAIL\nSubject: Incident with ${PLUGIN_NAME}" >>"$out_file"
    
    echo "Documentation and support info written to $out_file"
}

#--------------------------- Step 6: Optional Rollback --------------

perform_rollback() {
    local out_file="$REPORT_DIR/rollback_actions.txt"
    echo "Initiating rollback procedure..." >"$out_file"
    
    # Example: revert recent apt/dpkg installations within last hour
    if [[ -f "/var/log/dpkg.log" ]]; then
        echo "Identifying packages installed in the last hour..." >>"$out_file"
        recent_pkgs=$(awk -v now="$(date +%s)" -v onehour=$((60*60)) '
            $1=="install"{
                cmd="date -d \""$2" "$3"\" +%s"
                cmd | getline ts
                close(cmd)
                if (now - ts <= onehour) print $4
            }' /var/log/dpkg.log | sort -u || true)
        
        if [[ -n "$recent_pkgs" ]]; then
            echo "Packages to downgrade/remove: $recent_pkgs" >>"$out_file"
            for pkg in $recent_pkgs; do
                echo "Attempting to reinstall previous version of $pkg ..." >>"$out_file"
                sudo apt-get install -y "${pkg}=$(apt-cache policy "$pkg" | awk '/Installed:/ {print $2}')"
            done
        else
            echo "No recent package installs detected for rollback." >>"$out_file"
        fi
    else
        echo "dpkg log not found; skipping apt-based rollback." >>"$out_file"
    fi
    
    # Example: revert git repo to previous commit if applicable
    if [[ -d "/opt/infrastructure_repo/.git" ]]; then
        echo -e "\nReverting Git repository to previous commit..." >>"$out_file"
        pushd /opt/infrastructure_repo >/dev/null
        prev_commit=$(git rev-parse HEAD~1)
        git reset --hard "$prev_commit"
        popd >/dev/null
        echo "Repository rolled back to $prev_commit." >>"$out_file"
    else
        echo "No Git repository to rollback." >>"$out_file"
    fi
    
    echo "Rollback actions logged in $out_file"
}

prompt_and_maybe_rollback() {
    read -rp "Do you want to attempt a rollback based on the findings? [y/N]: " answer
    case "${answer,,}" in
        y|yes)
            perform_rollback
            ;;
        *)
            echo "Skipping rollback as per operator choice."
            ;;
    esac
}

#--------------------------- Main Execution Flow --------------------

main() {
    echo "=== Incident Investigation Started: $(date) ==="
    
    analyze_network_logs
    collect_system_metrics
    detect_metric_anomalies
    review_recent_changes
    run_stress_test
    consult_documentation
    
    echo -e "\nAll investigative steps completed.\nReports are located in $REPORT_DIR"
    
    prompt_and_maybe_rollback
    
    echo "=== Incident Investigation Finished: $(date) ==="
}

main "$@"